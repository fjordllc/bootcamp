#!/usr/bin/env ruby
# frozen_string_literal: true

usage = 'Usage: bin/cloud-ci [--help]'
if ARGV == ['--help']
  puts usage
  exit
end
abort usage unless ARGV.empty?

require 'open3'

Dir.chdir File.expand_path('..', __dir__)

def git_output(*args, allowed_statuses: [])
  output, status = Open3.capture2('git', *args)
  unless status.success? || allowed_statuses.include?(status.exitstatus)
    abort 'Could not verify the branch on origin. Check Git configuration and network access.'
  end

  output.strip
end

branch = git_output('symbolic-ref', '--quiet', '--short', 'HEAD')
abort 'Cloud CI requires a clean checkout. Commit and push first.' unless git_output('status', '--porcelain').empty?

head = git_output('rev-parse', '--verify', 'HEAD')
remote = git_output('ls-remote', '--exit-code', 'origin', "refs/heads/#{branch}", allowed_statuses: [2])
abort "Push #{branch} to origin before running cloud CI (local and remote HEAD must match)." unless remote.split.first == head

# Pin both repository and ref: never let gh default to main or another fork.
repository = git_output('remote', 'get-url', 'origin')
exec 'gh', 'workflow', 'run', 'ci.yml', '--repo', repository, '--ref', branch
