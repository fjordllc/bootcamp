div
  .form-item-actions
    ul.form-item-actions__items
      li.form-item-actions__item (
        class=(preset_id.present? ? '' : 'is-hidden')
        data-report-preset-target='replaceReportAction'
      )
        button.form-item-actions__text-link.is-danger(
          type='button'
          data-action='click->report-preset#replaceReportWithPreset'
        )
          | テンプレートを反映する

      li.form-item-actions__item
        button.a-button.is-sm.is-secondary.is-block(
          type='button'
          data-action='click->report-preset#openModal'
          data-report-preset-target='openModalButton'
        ) = preset_id.present? ? 'テンプレート変更' : 'テンプレート登録'

      li.form-item-actions__item
        button.a-button.is-sm.is-secondary.is-block(
          type='button'
          data-action='click->report-latest#replaceReport'
        )
          | 最新の日報を複製

  .a-overlay.is-js.is-hidden(
    data-report-preset-target='modal'
    data-action='click->report-preset#clickOutside'
    role='dialog'
    aria-modal='true'
    aria-labelledby='report-preset-modal-title'
  )
    .a-card.is-modal
      header.card-header.is-sm
        h1#report-preset-modal-title.card-header__title 日報テンプレート
      hr.a-border

      .a-form-tabs.js-tabs
        .a-form-tabs__tab.js-tabs__tab.is-active(
          data-action='click->report-preset#openPresetEditTab'
          data-report-preset-target='presetEditTab'
        )
          | テンプレート
        .a-form-tabs__tab.js-tabs__tab(
          data-action='click->report-preset#openPreviewTab'
          data-report-preset-target='previewTab'
        )
          | プレビュー

      .a-markdown-input.js-markdown-parent
        .a-markdown-input__inner.js-tabs__content.is-active(
          data-report-preset-target='presetEditPanel'
        )
          textarea.a-text-input.a-markdown-input__textarea.has-max-height#js-preset-content(
            data-preview='#js-preset-preview'
            data-report-preset-target='presetInput'
            name='report_preset[description]'
            data-action='input->report-preset#updateSubmitButtonState'
          ) = preset_description

        .a-markdown-input__inner.js-tabs__content.a-long-text.is-md.a-markdown-input__preview.has-max-height(
          id='js-preset-preview'
          data-report-preset-target='previewPanel'
        )

      footer.card-footer
        .card-main-actions
          ul.card-main-actions__items
            li.card-main-actions__item
              button.a-button.is-primary.is-sm.is-block(
                type='button'
                data-action='click->report-preset#savePreset'
                data-report-preset-target='submitButton'
                disabled=true
              ) = preset_id.present? ? '変更' : '登録'
            li.card-main-actions__item.is-sub
              .card-main-actions__muted-action(
                data-action='click->report-preset#closeModal'
              )
                | キャンセル
