.block-checks.is-1-item
  .block-checks__item
    .a-block-check.is-checkbox(data-controller='date-input-toggler')
      = check_box_tag :graduation_checkbox, 1, false, class: 'a-toggle-checkbox', data: { \
        date_input_toggler_target: 'checkbox', \
        action: 'change->date-input-toggler#syncDateInput' \
      }
      .a-block-check__label.is-ta-left.has-input
        = f.label :graduated_on, class: '', for: 'graduation_checkbox' do
          | 卒業済
        .form-item__inline-form-item(data-date-input-toggler-target='dateInputArea')
          = f.date_field :graduated_on, class: 'a-text-input', data: { date_input_toggler_target: 'dateInput' }
