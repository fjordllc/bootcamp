.form-item
  = f.label :profile_image, class: 'a-form-label'
  .form-item-file-input.a-file-input(
    data-controller="file-input"
  )
    label(
      data-file-input-target="preview"
      data-action="dragover->file-input#dragover drop->file-input#drop"
    )
      - if f.object.profile_image.attached?
        = image_tag f.object.profile_image
        p 画像を変更
      - else
        p 画像を選択
      = f.file_field :profile_image, data: { file_input_target: 'input', action: 'change->file-input#change' }
