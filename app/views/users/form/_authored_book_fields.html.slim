= cocooned_item class: 'col-xs-12' do
  .books-form
    .books-form__header
      .books-form__delete
        = cocooned_remove_item_link f, class: 'books-form__delete-link' do
          i.fas.fa-times
    .books-form__items
      .books-form-item
        = f.label :title, class: 'a-form-label'
        = f.text_field :title, class: 'a-text-input'
      .books-form-item
        = f.label :url, class: 'a-form-label'
        = f.text_field :url, class: 'a-text-input'
      .books-form-item
        = f.label :cover, class: 'a-form-label'
        .form-item-file-input.a-file-input.is-book(
          data-controller="file-input"
        )
          label(
            data-file-input-target="preview"
            data-action="dragover->file-input#dragover drop->file-input#drop"
          )
            - if f.object.cover.attached?
              p 画像を変更
              = f.file_field :cover, data: { file_input_target: 'input', action: 'change->file-input#change' }
              = image_tag f.object.cover
            - else
              p 画像を選択
              = f.file_field :cover, data: { file_input_target: 'input', action: 'change->file-input#change' }
