dl.card-counts__items
  ruby:
    activities = [
      { name: '日報', count: user_activity_count(user, :reports, @user_activity_counts), url: user_reports_path(user) },
      { name: '提出物', count: user_activity_count(user, :products, @user_activity_counts), url: user_products_path(user) },
      { name: 'コメント', count: user_activity_count(user, :comments, @user_activity_counts), url: user_comments_path(user) },
      { name: '質問', count: user_activity_count(user, :questions, @user_activity_counts), url: user_questions_path(user) },
      { name: '回答', count: user_activity_count(user, :answers, @user_activity_counts), url: user_answers_path(user) },
      { name: 'ポートフォリオ', count: user_activity_count(user, :works, @user_activity_counts), url: user_portfolio_path(user) },
      { name: '特別イベント', count: user_activity_count(user, :participations, @user_activity_counts), url: nil },
      { name: '定期イベント', count: user_activity_count(user, :regular_event_participations, @user_activity_counts), url: nil }
    ]
  - activities.each do |activity|
    .card-counts__item
      .card-counts__item-inner
        dt.card-counts__item-label = activity[:name]
        dd.card-counts__item-value class=('is-empty' if activity[:count].zero?)
          - if activity[:count].zero? || activity[:url].nil?
            = activity[:count]
          - else
            = link_to activity[:count], activity[:url], class: 'a-text-link'
