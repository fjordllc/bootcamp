- title "Q&A: #{truncate(@question.title, length: 35, omission: '...')}"
- set_meta_tags og: { title: "Q&A: #{@question.title}" }
- content_for :head_last do
  noscript
    = stylesheet_link_tag 'answer-fallback', media: 'all'
- if @question.practice
  - set_meta_tags description: "#{@question.user.long_name}さんが投稿した、プラクティス「#{@question.practice.title}」に関する質問「#{@question.title}」のページです。"
- else
  - set_meta_tags description: "#{@question.user.long_name}さんが投稿した、質問「#{@question.title}」のページです。この質問に関連するプラクティスはありません。"

= render 'questions_and_pair_works/questions_and_pair_works_header'
- if notice
  noscript
    .flash.is-notice
      .container
        .flash__container
          p.flash__message = notice
.page-main
  = render 'questions_and_pair_works/questions_and_pair_works_page_main_header'
  hr.a-border

  .page-body
    .page-body__inner.has-side-nav
      .container.is-md data-controller='answer-loading' data-action='turbo:before-cache@document->answer-loading#reset'
        article.question.page-content
          = render 'questions/question_header', question: @question
          = render 'questions/question_body', question: @question
        .loading-content data-answer-loading-target='placeholder'
          - 3.times do
            = render 'questions/comment_placeholder'
        .answer-content.is-hidden data-answer-loading-target='content'
          header.thread-comments__header
            h2.thread-comments__title
              | 回答・コメント
          .answers-list id=dom_id(@question, :answers)
            - @answers.each do |answer|
              = render 'questions/answer', question: @question, user: current_user, answer: answer
          .new-answer-container data-controller='new-answer' data-new-answer-question-id-value=@question.id data-action='turbo:submit-end->new-answer#submitEnd'
            = render 'questions/new_answer', question: @question, user: current_user, answer: @answer
      nav.a-side-nav aria-label="関連する質問"
        .a-side-nav__inner
          header.a-side-nav__header
            h2.a-side-nav__title
              - if @question.practice
                = link_to @question.practice,
                  class: 'a-side-nav__title-link' do
                  = @question.practice.title
              - else
                | 関連プラクティス無し
          hr.a-border
          .a-side-nav__body
            = render 'questions/nav_questions', questions: @practice_questions
          hr.a-border
          footer.card-footer
            .card-footer__footer-link
              = link_to questions_path(practice_id: @question.practice), class: 'card-footer__footer-text-link' do
                | 全て見る

= render '/shared/modal', id: 'modal-delete-request', modal_title: '質問の削除申請' do
  .modal__description.is-md
    .a-long-text
      p
        | せっかく作った質問を操作ミスで削除してしまわないように、
        | 削除ができないようになっています。
        | 質問の削除をする場合は、相談部屋にこのページの URL <code>#{request.url}</code> を貼り、
        | 削除の申請をお願いします。
      p
        = link_to action_uncompleted_index_path(current_user.talk), target: '_blank', rel: 'noopener' do
          | 相談部屋はこちら
