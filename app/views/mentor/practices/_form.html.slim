= form_with model: [:mentor, practice], local: true, class: 'form', html: { name: 'practice' }, data: { controller: 'template-form' } do |f|
  = render 'errors', object: practice
  .form-item
    .row
      .col-md-6.col-xs-12
        = f.label :title, class: 'a-form-label is-required'
        = f.text_field :title, class: 'a-text-input js-warning-form', placeholder: 'HTMLの基本を理解する'
  .form-item
    = f.label :categories, class: 'a-form-label is-required'
    .checkboxes
      ul.checkboxes__items
        = f.collection_check_boxes :category_ids, Category.all, :id, :name, class: 'label-checkbox' do |b|
          li.checkboxes__item
            = b.check_box(class: 'a-toggle-checkbox')
            = b.label { b.text }
  .form-item
    .row.js-markdown-parent
      .col-md-6.col-xs-12
        = f.label :ogp_image, class: 'a-form-label'
        .form-item-file-input.js-file-input.a-file-input
          label.js-file-input__preview(for='practice_ogp_image')
            - if f.object.ogp_image.attached?
              = image_tag f.object.ogp_image.variant(resize_to_limit: [100, 100])
              p 画像を変更
            - else
              p 画像を選択
            = f.file_field :ogp_image
        .a-form-help
          p
            | ここにアップロードした画像が、X（Twitter）、Facebook で投稿した際に表示される画像として使われます。
            | 画像サイズが #{PracticesHelper::OGP_SIZE[0]}px x #{PracticesHelper::OGP_SIZE[1]}px でない場合は、アスペクト比を維持してリサイズし、必要に応じて中央部分を切り取って #{PracticesHelper::OGP_SIZE[0]}px x #{PracticesHelper::OGP_SIZE[1]}px に調整します。
  .form-item
    .row.js-markdown-parent
      .col-md-6.col-xs-12
        = f.label :summary, class: 'a-form-label'
        = f.text_area :summary,
          class: 'a-text-input is-md js-warning-form'
        .a-form-help
          p
            | プラクティスの概要、目的、これを習得することでできるようになることなどを入力してください。
            br
            | 未ログインでプラクティスページでアクセスしたときも、ここに入力した情報は表示されます。
  .form-item
    .row.js-markdown-parent
      .col-md-6.col-xs-12
        = f.label :description, class: 'a-form-label is-required'
        = f.text_area :description,
          class: 'a-text-input js-warning-form markdown-form__text-area js-markdown',
          data: { 'preview': '.js-description-preview' }
      .col-md-6.col-xs-12
        .a-form-label プレビュー
        .js-description-preview.a-long-text.is-md.markdown-form__preview
  .form-item
    .row.js-markdown-parent
      .col-md-6.col-xs-12
        = f.label :goal, class: 'a-form-label is-required'
        = f.text_area :goal,
          class: 'a-text-input js-warning-form markdown-form__text-area js-markdown',
          data: { 'preview': '.js-goal-preview' }
      .col-md-6.col-xs-12
        .a-form-label プレビュー
        .js-goal-preview.a-long-text.is-md.markdown-form__preview
  .form-item
    .row.js-markdown-parent
      .col-md-6.col-xs-12
        = f.label :memo, class: 'a-form-label'
        = f.text_area :memo,
          class: 'a-text-input js-warning-form markdown-form__text-area js-markdown',
          data: { 'preview': '.js-memo-preview' }
      .col-md-6.col-xs-12
        .a-form-label プレビュー
        .js-memo-preview.a-long-text.is-md.markdown-form__preview
  .form-item
    label.a-form-label
      | 参考書籍
    #reference_books
      = cocooned_container class: 'row' do
        = f.fields_for :practices_books do |practices_book|
          = render 'book_fields', f: practices_book
        .col-xs-12.books-form__add
          = cocooned_add_item_link f, :practices_books, partial: 'book_fields', class: 'a-button is-md is-primary' do
            i.fa-regular.fa-plus
            span
              | 書籍を選択
  .form-item
    = f.label :submission, class: 'a-form-label'
    .checkboxes
      ul.checkboxes__items
        li.checkboxes__item
          = f.check_box :submission, class: 'a-toggle-checkbox', data: { template_form_target: 'submission', action: 'change->template-form#toggleSubmission' }
          = f.label :submission
            | 提出物がある場合はチェック
        li.checkboxes__item
          = f.check_box :open_product, class: 'a-toggle-checkbox'
          = f.label :open_product
            | OKをもらっていない人も提出物を見られるようにする場合はチェック
    = f.label :progress, class: 'a-form-label'
    .checkboxes
      ul.checkboxes__items
        li.checkboxes__item
          = f.check_box :include_progress, class: 'a-toggle-checkbox'
          = f.label :include_progress
            | 進捗の計算に含むようにする場合はチェック

  .form-item[ data-template-form-target="container" hidden=!f.object.submission? ]
    label.a-form-label
      | 提出物のテンプレート

    = f.fields_for :template do |template_form|
      - if template_form.object.persisted?
        - destroy_data = { template_form_target: 'destroy', \
          action: 'change->template-form#toggle' }

      .row.js-markdown-parent
        .col-md-6.col-xs-12
          - description_data = { preview: '.js-submission-template-preview', \
            template_form_target: 'description' }
          .template-form__textarea
            = template_form.text_area :description,
              class: 'a-text-input js-warning-form ' \
                'markdown-form__text-area js-markdown',
              data: description_data
            .template-form__deletion-status.hidden[
              data-template-form-target="status"
              role="status"
            ]
              p
                | プラクティスを更新すると削除されます。
              - if template_form.object.persisted?
                .template-form__deletion-actions.hidden[
                  data-template-form-target="actions"
                ]
                  = template_form.submit '更新する',
                    class: 'a-button is-lg is-primary is-block'
                  button.a-muted-text-link.template-form__cancel[
                    type="button"
                    data-action="click->template-form#cancelDeletion"
                  ]
                    | キャンセル
          - if template_form.object.persisted?
            .checkboxes.mt-3
              ul.checkboxes__items
                li.checkboxes__item
                  = template_form.check_box :_destroy,
                    class: 'a-toggle-checkbox js-warning-form',
                    data: destroy_data
                  = template_form.label :_destroy do
                    | 提出物のテンプレートを削除する

        .col-md-6.col-xs-12
          .js-submission-template-preview.a-long-text.is-md[
            class="markdown-form__preview"
            data-template-form-target="preview"
          ]

  .form-item
    .row.js-markdown-parent
      .col-md-6.col-xs-12
        = f.label :completion_image, class: 'a-form-label'
        .form-item-file-input.js-file-input.a-file-input
          label.js-file-input__preview(for='practice_completion_image')
            - if f.object.completion_image.attached?
              = image_tag f.object.completion_image.variant(resize_to_limit: [100, 100])
              p 画像を変更
            - else
              p 画像を選択
            = f.file_field :completion_image
        .a-form-help
          p 画像サイズ: 1200px × 630xp

  .form-actions
    ul.form-actions__items
      li.form-actions__item.is-main
        = f.submit nil, class: 'a-button is-lg is-primary is-block'
      li.form-actions__item.is-sub
        = link_to 'キャンセル', :back, class: 'a-button is-sm is-text'
