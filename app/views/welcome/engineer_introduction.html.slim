- content_for :extra_body_classes, 'welcome no-forms'
- title 'エンジニア紹介'
- set_meta_tags(site: 'FJORD BOOT CAMP（フィヨルドブートキャンプ）',
  description: '自ら学び続ける力を身につけたフィヨルドブートキャンプ卒業生を、採用をご検討の企業様へご紹介します。紹介料は入社時のみで、求人掲載や相談に費用はかかりません。')
ruby:
  steps = [
    ['ヒアリング', '希望する仕事、企業選びの条件、将来の目標を伺い、マッチしそうな企業をご案内します。'],
