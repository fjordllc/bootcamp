    ['選考', '選考内容に制限はありません。貴社で定めている採用試験を実施してください。'],
    ['結果・フィードバック', '選考結果をご連絡いただき、今後のマッチング改善のために理由も伺います。'],
    ['紹介料のお支払い', '紹介者の初出社を確認後、請求書をお送りします。']
  ]
  faqs = [
    ['受講生の年齢層や男女比は？', '就職支援利用者では20代後半が最も多く、次いで30代前半、20代前半です。男女比はおよそ6対4です。'],
    ['紹介から就職する卒業生の年収は？', '企業によって異なりますが、平均・最頻値ともにおよそ400万円です。'],
    ['卒業生は選考を受ける企業をどう決めますか？', '企業説明会動画や公開情報を確認し、カジュアル面談で理解を深めたうえで、本人が希望する企業へ選考を依頼します。']
  ]
  contract_steps = [
    ['契約書の確認', '契約書のひな形をお送りします。法務確認後、必要に応じて内容を調整します。'],
    ['オンラインで契約', '内容が確定したら、クラウドサインを使って契約を締結します。'],
    ['企業情報を掲載', '紹介企業リストへ追加し、受講生・卒業生が貴社を知れる状態にします。'],
    ['企業説明会へ参加', '合同企業説明会で発表いただき、録画をFBC内で継続して公開します。']
  ]

