section.a-card.is-toggle.practice-memo.is-only-mentor
  input.a-toggle-checkbox#toggle-mentor-memo-body(type='checkbox')
  label.card-header.is-sm(for="toggle-mentor-memo-body")
    h2.card-header__title
      | メンターメモを確認
    .is-hidden-then-checked
      i.fas.fa-angle-down
    .is-hidden-then-unchecked
      i.fas.fa-angle-up
  .memo
    = render 'products/practice_memo_content', practice: practice
