- sections = product_ai_review_sections(review.content)
section.a-card#product-ai-review
  header.card-header.is-sm
    h2.card-header__title
      | AIレビュー（メンター用）
  hr.a-border-tint
  .card-body
    .card-body__description
      .form__items data-controller="product-ai-review-reply"
        .form-item
          .a-long-text.is-md
            p
              | メンター・管理者だけに表示されるレビュー支援です。内容を確認してから、ご自身のコメントを作成してください。
            - body_html = md2html(escape_special_chars(sections[:body]))
            - allowed_tags = %w[p h2 h3 h4 h5 h6 ul ol li pre code] + \
              %w[em strong blockquote a hr br]
            = sanitize(body_html, tags: allowed_tags,\
              attributes: %w[href title])
        - if sections[:reply]
          .form-item
            .form-item__header
              h3.a-form-label#product-ai-review-reply-label
                | 受講生への返信案
              button.a-button.is-sm.is-secondary(
                type="button"
                data-action="product-ai-review-reply#copy")
                | 返信案をコピー
            = text_area_tag nil, sections[:reply], readonly: true, rows: 8,\
              class: 'a-text-input has-max-height product-ai-review__reply',\
              aria: { labelledby: 'product-ai-review-reply-label' },\
              data: { product_ai_review_reply_target: 'text' }
            .a-form-help(
              role="status"
              aria-live="polite"
              data-product-ai-review-reply-target="status")
