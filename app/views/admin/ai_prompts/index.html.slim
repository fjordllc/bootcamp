- title 'AIプロンプト一覧'

header.page-header
  .container
    .page-header__inner
      .page-header__start
        h2.page-header__title
          | 管理ページ

= render 'admin/admin_page_tabs'

main.page-main
  header.page-main-header
    .container
      .page-main-header__inner
        .page-main-header__start
          h1.page-main-header__title
            | AIプロンプト一覧
  hr.a-border
  .page-body
    .container.is-lg
      .admin-table
        table.admin-table__table
          thead.admin-table__header
            tr.admin-table__labels
              th.admin-table__label
                | プロンプト
              th.admin-table__label
                | 説明
              th.admin-table__label
                | 状態
              th.admin-table__label
                | 操作
          tbody.admin-table__items
            - @definitions.each do |key, definition|
              tr.admin-table__item
                td.admin-table__item-value
                  = definition.fetch(:name)
                td.admin-table__item-value
                  = definition.fetch(:description)
                td.admin-table__item-value
                  = AiPrompt.exists?(key:) ? '変更済み' : 'デフォルト'
                td.admin-table__item-value.is-text-align-center
                  = link_to edit_admin_ai_prompt_path(key),
                    class: 'a-button is-sm is-secondary is-icon',
                    aria: { label: '編集' } do
                    i.fa-solid.fa-pen aria-hidden='true'
