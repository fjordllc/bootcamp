- title 'AIプロンプト編集'

header.page-header
  .container
    .page-header__inner
      .page-header__start
        h2.page-header__title
          | 管理ページ

= render 'admin/admin_page_tabs'

main.page-main
  header.page-main-header
    .container
      .page-main-header__inner
        .page-main-header__start
          h1.page-main-header__title
            = "#{AiPrompt.definitions.fetch(@ai_prompt.key).fetch(:name)}編集"
        .page-main-header__end
          .page-main-header-actions
            .page-main-header-actions__items
              .page-main-header-actions__item
                = link_to admin_ai_prompts_path,
                  class: 'a-button is-md is-secondary is-block is-back' do
                  | AIプロンプト一覧
  hr.a-border
  .page-body
    .container.is-lg
      p
        = AiPrompt.definitions.fetch(@ai_prompt.key).fetch(:description)
      p
        | ユーザー名や対象ページなどの動的な情報は、保存した文章の後ろに自動で追加されます。
      = form_with model: @ai_prompt,
        url: admin_ai_prompt_path(@ai_prompt.key),
        method: :patch,
        local: true,
        class: 'form',
        html: { name: 'ai_prompt' } do |f|
        = render 'errors', object: @ai_prompt
        .form__items
          .form__items-inner
            .form-item
              = f.label :body, 'プロンプト', class: 'a-form-label'
              = f.text_area :body,
                rows: 30,
                class: 'a-text-input js-warning-form'
        .form-actions
          ul.form-actions__items
            li.form-actions__item.is-main
              button.a-button.is-lg.is-primary.is-block
                | 内容を保存
            li.form-actions__item.is-sub
              = link_to 'キャンセル',
                admin_ai_prompts_path,
                class: 'a-button is-sm is-text'
